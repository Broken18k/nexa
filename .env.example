# --- RPC (server-only) ---
BSC_RPC_URLS=https://your-primary-bsc-rpc,https://your-fallback-bsc-rpc
BSC_LOG_RPC_URLS=https://your-log-capable-bsc-rpc

# --- Agent wallet (PUBLIC address only) ---
NEXA_WALLET_ADDRESS=0xYOUR_PUBLIC_AGENT_WALLETCONFIG_REQUIRED

# --- Signer: set ONLY in your host's secret store, never in this file ---
# NEXA_PRIVATE_KEY=<secret manager>

# --- Execution: NO_SIGNER | SIGNER_READY | DRY_RUN | LIVE_LIMITED | LIVE_AUTONOMOUS ---
NEXA_EXECUTION_MODE=DRY_RUN
NEXA_EMERGENCY_STOP=true
# NEXA_LIVE_AUTONOMOUS_CONFIRM=I_ACCEPT_UNATTENDED_RISK

# --- Hard policy limits (clamped by code ceilings) ---
NEXA_MAX_TRADE_BNB=0.02
NEXA_MAX_TOTAL_EXPOSURE_BNB=0.1
NEXA_MAX_TOKEN_EXPOSURE_BNB=0.05
NEXA_MAX_DAILY_LOSS_BNB=0.02
NEXA_COOLDOWN_SECONDS=900
NEXA_MAX_SLIPPAGE_BPS=300
NEXA_MIN_LIQUIDITY_BNB=25
NEXA_MAX_SNAPSHOT_AGE_SECONDS=30

# --- Gas / receipts ---
NEXA_MAX_GAS_LIMIT=400000
NEXA_MAX_GAS_PRICE_GWEI=3
NEXA_CONFIRMATIONS=3
NEXA_TX_TIMEOUT_SECONDS=90

# --- Durable storage ---
NEXA_CHECKPOINT_PATH=.data/nexa-checkpoint.json
NEXA_HOLDER_INDEX_PATH=.data/nexa-holders.json
NEXA_LEDGER_PATH=.data/nexa-ledger.json
NEXA_POSITIONS_PATH=.data/nexa-positions.json
NEXA_TOKEN_METADATA_PATH=.data/nexa-token-metadata.json
